<div class="personal-container">

    <div class="personal-header">

        <h1 class="personal-title">
            Panel Personal
        </h1>

        <p class="personal-subtitle">
            Administra cartas y contenido de MTGRoyal
        </p>

    </div>

    <div class="personal-content">

        <div class="personal-card">

            <h2 class="section-title">
                Agregar Nueva Carta
            </h2>

            <div class="form-grid">

                <input
                    type="text"
                    class="personal-input"
                    placeholder="Nombre de la carta"
                />

                <input
                    type="text"
                    class="personal-input"
                    placeholder="Precio"
                />

                <input
                    type="text"
                    class="personal-input"
                    placeholder="Rareza"
                />

                <input
                    type="text"
                    class="personal-input"
                    placeholder="Tipo"
                />

                <input
                    type="text"
                    class="personal-input"
                    placeholder="Colección"
                />

                <input
                    type="text"
                    class="personal-input"
                    placeholder="Ruta de imagen"
                />

            </div>

            <button class="save-btn">
                Guardar Carta
            </button>

        </div>

        <div class="personal-card">

            <h2 class="section-title">
                Administración
            </h2>

            <p class="admin-text">
                Aquí podrás editar, eliminar y administrar
                todas las cartas registradas en la base de datos.
            </p>

        </div>

    </div>

</div>