@using MTGRoyal.Controllers
@{
    var form = ViewBag.Form as PersonalController.CartaCreateRequest;
    var rarezas = ViewBag.Rarezas as IEnumerable<MTGRoyal.Models.Rareza> ?? Enumerable.Empty<MTGRoyal.Models.Rareza>();
    var colores = ViewBag.Colores as IEnumerable<MTGRoyal.Models.Colore> ?? Enumerable.Empty<MTGRoyal.Models.Colore>();
    var selectedColors = form?.ColorIds ?? [];
}

<div class="personal-container">

    <div class="personal-header">

        <h1 class="personal-title">
            Panel Personal
        </h1>

        <p class="personal-subtitle">
            Administra cartas y contenido de MTGRoyal
        </p>

    </div>

    <div class="personal-content">

        <div class="personal-card">

            <h2 class="section-title">
                Agregar Nueva Carta
            </h2>

            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="personal-message success-message">
                    @successMessage
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="personal-message error-message">
                    Revisa los datos del formulario e intenta nuevamente.
                </div>
            }

            <form asp-controller="Personal" asp-action="Index" method="post">

                @Html.AntiForgeryToken()

                <div class="form-grid">

                    <input
                        type="text"
                        name="Nombre"
                        class="personal-input"
                        placeholder="Nombre de la carta"
                        value="@form?.Nombre"
                        required
                    />

                    <input
                        type="number"
                        name="Precio"
                        class="personal-input"
                        placeholder="Precio"
                        value="@(form?.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                        min="0"
                        step="0.01"
                        required
                    />

                    <select
                        name="RarezaId"
                        class="personal-input"
                        required>

                        <option value="">
                            Selecciona una rareza
                        </option>

                        @foreach (var rareza in rarezas)
                        {
                            <option value="@rareza.Id" selected="@(form?.RarezaId == rareza.Id)">
                                @rareza.Nombre
                            </option>
                        }

                    </select>

                    <input
                        type="text"
                        name="Tipo"
                        class="personal-input"
                        placeholder="Tipo"
                        value="@form?.Tipo"
                        required
                    />

                    <input
                        type="text"
                        name="Coleccion"
                        class="personal-input"
                        placeholder="Coleccion"
                        value="@form?.Coleccion"
                    />

                    <input
                        type="text"
                        name="ImagenUrl"
                        class="personal-input"
                        placeholder="Ruta de imagen"
                        value="@form?.ImagenUrl"
                    />

                </div>

                <div class="personal-color-section">

                    <span class="personal-color-label">
                        Colores
                    </span>

                    <div class="personal-color-options">

                        @foreach (var color in colores)
                        {
                            <label class="personal-color-option">

                                <input
                                    type="checkbox"
                                    name="ColorIds"
                                    value="@color.Id"
                                    checked="@selectedColors.Contains(color.Id)"
                                />

                                <span>
                                    @color.Nombre
                                </span>

                            </label>
                        }

                    </div>

                </div>

                <button type="submit" class="save-btn">
                    Guardar Carta
                </button>

            </form>

        </div>

        <div class="personal-card">

            <h2 class="section-title">
                Administracion
            </h2>

            <p class="admin-text">
                Aqui podras editar, eliminar y administrar
                todas las cartas registradas en la base de datos.
            </p>

        </div>

    </div>

</div>
