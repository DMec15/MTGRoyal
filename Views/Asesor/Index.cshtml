@using MTGRoyal.Services
@{
    var chatMessages =
        ViewBag.ChatMessages as IEnumerable<AdvisorMessageState>
        ?? Enumerable.Empty<AdvisorMessageState>();
}

<form
    id="advisorForm"
    asp-action="Index"
    method="post">

    @Html.AntiForgeryToken()

    <div class="advisor-container">

        <div class="advisor-header">

            <div class="advisor-top">

                <div class="advisor-avatar">
                    🤖
                </div>

                <div>

                    <h1 class="advisor-title">
                        Asesor con IA
                    </h1>

                    <p class="advisor-subtitle">
                        Tu experto personal en Magic: The Gathering
                    </p>

                </div>

            </div>

            <div class="suggested-section">

                <p class="suggested-label">
                    Preguntas sugeridas:
                </p>

                <div class="suggested-buttons">

                    <button
                        type="button"
                        class="suggested-btn"
                        onclick="sendSuggestedQuestion(this)">
                        ¿Que mazo me recomiendas para jugar con Dinosaurios?
                    </button>

                    <button
                        type="button"
                        class="suggested-btn"
                        onclick="sendSuggestedQuestion(this)">
                        ¿Cuales son las mejores cartas para Commander?
                    </button>

                    <button
                        type="button"
                        class="suggested-btn"
                        onclick="sendSuggestedQuestion(this)">
                        ¿Que cartas son las más importantes en Standard?
                    </button>

                </div>

            </div>

        </div>

        <div class="chat-container">

            <div class="chat-messages" id="chatMessages">

                <div class="message ai-message">

                    <div class="message-bubble">

                        ¡Hola! Soy tu Asesor de Magic IA.
                        Puedo ayudarte a construir mazos,
                        analizar estrategias y recomendar cartas.

                    </div>

                </div>

                @foreach (var message in chatMessages)
                {
                    var messageClass =
                        message.Role == "user"
                            ? "user-message"
                            : "ai-message";

                    <div class="message @messageClass">

                        <div class="message-bubble">
                            @message.Text
                        </div>

                    </div>
                }

            </div>

            <div class="chat-input-section">

                <textarea
                    id="chatInput"
                    name="prompt"
                    class="chat-input"
                    placeholder="Escribe tu pregunta..."
                ></textarea>

                <button
                    type="submit"
                    class="send-btn">

                    ➤

                </button>

            </div>

        </div>

    </div>

</form>

<script>
    // Envia una pregunta sugerida al formulario del asesor.
    function sendSuggestedQuestion(button){

        const chatInput =
            document.getElementById("chatInput");

        const advisorForm =
            document.getElementById("advisorForm");

        if(!chatInput || !advisorForm)
            return;

        chatInput.value =
            button.innerText.trim();

        advisorForm.submit();

    }

    const chatMessages =
        document.getElementById("chatMessages");

    if(chatMessages){

        chatMessages.scrollTop =
            chatMessages.scrollHeight;

    }
</script>
