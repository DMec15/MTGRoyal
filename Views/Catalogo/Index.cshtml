@model IEnumerable<MTGRoyal.Models.Carta>
@using System.Globalization

@functions {
    // Convierte el nombre del color al codigo usado por los filtros.
    private static string GetColorCode(string? color)
    {
        var normalized = (color ?? string.Empty).Trim().ToLowerInvariant();

        return normalized switch
        {
            "w" or "white" or "blanco" => "W",
            "u" or "blue" or "azul" => "U",
            "b" or "black" or "negro" => "B",
            "r" or "red" or "rojo" => "R",
            "g" or "green" or "verde" => "G",
            _ => color ?? string.Empty
        };
    }

    // Obtiene la clase CSS correspondiente a la rareza.
    private static string GetRarityClass(string? rarity)
    {
        var normalized = (rarity ?? string.Empty).Trim().ToLowerInvariant();

        if (normalized.Contains("mit"))
            return "mythic";

        if (normalized.Contains("rara"))
            return "rare";

        if (normalized.Contains("infrecuente"))
            return "uncommon";

        if (normalized.Contains("com"))
            return "common";

        return string.Empty;
    }
}

<div class="catalog-container">

    <div class="catalog-header">

        <h1 class="catalog-title">
            Catalogo de Cartas
        </h1>

        <p class="catalog-subtitle">
            Explora nuestra coleccion completa
        </p>

        <div class="search-section">
            <div class="search-wrapper">

                <input
                    type="text"
                    id="catalogSearch"
                    class="catalog-search"
                    placeholder="Buscar cartas por nombre..."
                />
            </div>
        </div>

        <div class="filters-section">

            <!-- FILTRO COLORES -->

            <div class="colors-filter">

                <span class="filter-label">
                    Colores:
                </span>

                <button class="color-chip white-chip" data-color="W">
                    Blanco
                </button>

                <button class="color-chip blue-chip" data-color="U">
                    Azul
                </button>

                <button class="color-chip black-chip" data-color="B">
                    Negro
                </button>

                <button class="color-chip red-chip" data-color="R">
                    Rojo
                </button>

                <button class="color-chip green-chip" data-color="G">
                    Verde
                </button>

            </div>

            <!-- FILTRO RAREZA -->

            <select class="filter-select" id="rarityFilter">

                <option value="">
                    Todas las rarezas
                </option>

                <option value="Comun">
                    Comun
                </option>

                <option value="Infrecuente">
                    Infrecuente
                </option>

                <option value="Rara">
                    Rara
                </option>

                <option value="Mitica">
                    Mitica
                </option>

            </select>

            <!-- FILTRO TIPO -->

            <select class="filter-select" id="typeFilter">

                <option value="">
                    Todos los tipos
                </option>

                <option value="Criatura">
                    Criatura
                </option>

                <option value="Instantaneo">
                    Instantaneo
                </option>

                <option value="Conjuro">
                    Conjuro
                </option>

                <option value="Encantamiento">
                    Encantamiento
                </option>

                <option value="Artefacto">
                    Artefacto
                </option>

                <option value="Planeswalker">
                    Planeswalker
                </option>

                <option value="Tierra">
                    Tierra
                </option>

            </select>

        </div>

    </div>

    <!-- CONTENEDOR CARTAS -->

    <div class="cards-container">

        @foreach (var carta in Model ?? Enumerable.Empty<MTGRoyal.Models.Carta>())
        {
            var imageUrl = carta.ImagenUrl ?? string.Empty;
            var price = carta.Precio.ToString("C", CultureInfo.GetCultureInfo("en-US"));
            var colors = string.Join(",", carta.Colors.Select(color => GetColorCode(color.Nombre)));
            var rarityName = carta.Rareza.Nombre;
            var rarityClass = GetRarityClass(rarityName);
            var collection = carta.Coleccion ?? "Catalogo";

            <div class="mtg-card"
                 data-name="@carta.Nombre"
                 data-rarity="@rarityName"
                 data-type="@carta.Tipo"
                 data-colors="@colors"
                 data-modal-name="@carta.Nombre"
                 data-modal-image="@imageUrl"
                 data-modal-price="@price"
                 data-modal-rarity="@rarityName"
                 data-modal-rarity-class="@rarityClass"
                 data-modal-type="@carta.Tipo"
                 data-modal-set="@collection"
                 onclick="openModalFromCard(this)">

                <img
                    src="@imageUrl"
                    class="card-image"
                />

                <div class="card-content">

                    <h3 class="card-title">
                        @carta.Nombre
                    </h3>

                    <div class="card-price-section">

                        <span class="card-price">
                            @price
                        </span>

                    </div>

                    <div class="card-tags">

                        <span class="rarity @rarityClass">
                            @rarityName
                        </span>

                        <span class="set-tag">
                            @collection
                        </span>

                    </div>

                </div>

            </div>
        }

    </div>

    <!-- MODAL -->

    <div id="cardModal" class="modal-overlay">

        <div class="modal-content">

            <div class="modal-header">

                <h2 id="modalCardName">
                    Nombre Carta
                </h2>

                <button class="close-btn" onclick="closeModal()">
                    x
                </button>

            </div>

            <div class="modal-body">

                <div class="modal-image-section">

                    <img
                        id="modalCardImage"
                        src=""
                        class="modal-card-image"
                    />

                </div>

                <div class="modal-info">

                    <div class="price-section">

                        <span class="price-label">
                            Precio actual
                        </span>

                        <div class="price-row">

                            <span id="modalCardPrice" class="modal-price">
                                $0.00
                            </span>

                        </div>

                    </div>

                    <div class="info-group">

                        <span class="info-label">
                            Rareza
                        </span>

                        <span id="modalRarity" class="rarity mythic">
                            Mitica
                        </span>

                    </div>

                    <div class="info-group">

                        <span class="info-label">
                            Tipo
                        </span>

                        <span id="modalType">
                            Tipo
                        </span>

                    </div>

                    <div class="info-group">

                        <span class="info-label">
                            Coleccion
                        </span>

                        <span id="modalSet">
                            Catalogo
                        </span>

                    </div>

                    <div class="info-note">

                        Nota: Los precios pueden variar en funcion de la disponibilidad y el estado del mercado.

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<script>
    // Abre el modal usando los datos guardados en la carta.
    function openModalFromCard(card){

        openModal(
            card.dataset.modalName,
            card.dataset.modalImage,
            card.dataset.modalPrice,
            card.dataset.modalRarity,
            card.dataset.modalType,
            card.dataset.modalSet
        );

        const modalRarity = document.getElementById("modalRarity");

        if(modalRarity){

            modalRarity.className =
                `rarity ${card.dataset.modalRarityClass || ""}`;

        }

    }
</script>
