@model IEnumerable<MTGRoyal.Models.Carta>
@using System.Globalization

<div class="budget-container">

    <div class="budget-header">

        <div class="budget-top">

            <div class="wallet-icon">
                💰
            </div>

            <div>

                <h1 class="budget-title">
                    Planificador de Presupuesto
                </h1>

                <p class="budget-subtitle">
                    Construye tu mazo dentro de tu presupuesto
                </p>

            </div>

        </div>

        <div class="budget-input-section">

            <input
                type="number"
                id="budgetInput"
                class="budget-input"
                placeholder="Ingresa tu presupuesto"
                oninput="updateBudget()"
            />

        </div>

        <div class="budget-progress-section">

            <div class="budget-values">

                <span id="spentText">
                    Gastado: $0.00
                </span>

                <span id="remainingText">
                    Restante: $0.00
                </span>

            </div>

            <div class="progress-bar">

                <div
                    class="progress-fill"
                    id="progressFill">
                </div>

            </div>

        </div>

    </div>

    <div class="budget-content">

        <div class="budget-cards-section">

            <div class="budget-section-header">

                <h2 class="section-title">
                    Cartas Disponibles
                </h2>

                <input
                    type="text"
                    id="budgetCardSearch"
                    class="budget-card-search"
                    placeholder="Buscar carta..."
                    oninput="filterBudgetCards(this.value)"
                />

            </div>

            <div class="budget-cards-grid">

                @foreach (var carta in Model ?? Enumerable.Empty<MTGRoyal.Models.Carta>())
                {
                    var imageUrl = carta.ImagenUrl ?? string.Empty;
                    var priceText = carta.Precio.ToString("C", CultureInfo.GetCultureInfo("en-US"));
                    var priceValue = carta.Precio.ToString(CultureInfo.InvariantCulture);

                    <div class="budget-card" data-card-name="@carta.Nombre">

                        <img
                            src="@imageUrl"
                            class="budget-card-image"
                        />

                        <div class="budget-card-content">

                            <h3 class="budget-card-title">
                                @carta.Nombre
                            </h3>

                            <div class="budget-card-bottom">

                                <span class="budget-card-price">
                                    @priceText
                                </span>

                                <span class="budget-rarity">
                                    @carta.Rareza
                                </span>

                            </div>

                            <button
                                class="add-btn"
                                data-card-name="@carta.Nombre"
                                data-card-price="@priceValue"
                                onclick="addBudgetCardToCart(this)">

                                + Agregar

                            </button>

                        </div>

                    </div>
                }

            </div>

        </div>

        <div class="cart-section">

            <h2 class="section-title">
                🛒 Mi Carrito
            </h2>

            <div id="cartItems">

                <p class="empty-cart">
                    Tu carrito está vacío
                </p>

            </div>

            <div class="cart-total">

                <span>Total:</span>

                <span id="cartTotal">
                    $0.00
                </span>

            </div>

        </div>

    </div>

</div>

<script>
    function addBudgetCardToCart(button){

        addToCart(
            button.dataset.cardName,
            parseFloat(button.dataset.cardPrice)
        );

    }

    function filterBudgetCards(text){

        const searchValue =
            text.toLowerCase().trim();

        const cards =
            document.querySelectorAll(".budget-card");

        cards.forEach(card => {

            const cardName =
                (card.dataset.cardName || "").toLowerCase();

            card.style.display =
                cardName.includes(searchValue)
                    ? "block"
                    : "none";

        });

    }
</script>
