@model IEnumerable<MTGRoyal.Models.Carta>
@using System.Globalization

<div class="budget-container">

    <div class="budget-header">

        <div class="budget-top">

            <div class="wallet-icon">
                💰
            </div>

            <div>

                <h1 class="budget-title">
                    Planificador de Presupuesto
                </h1>

                <p class="budget-subtitle">
                    Construye tu mazo dentro de tu presupuesto
                </p>

            </div>

        </div>

        <div class="budget-input-section">

            <input
                type="number"
                id="budgetInput"
                class="budget-input"
                placeholder="Ingresa tu presupuesto"
                oninput="updateBudget()"
            />

        </div>

    </div>

    <div class="budget-content">

        <div class="budget-cards-section">

            <div class="budget-section-header">

                <h2 class="section-title">
                    Cartas Disponibles
                </h2>

                <input
                    type="text"
                    id="budgetCardSearch"
                    class="budget-card-search"
                    placeholder="Buscar carta..."
                    oninput="filterBudgetCards(this.value)"
                />

            </div>

            <div class="budget-cards-grid">

                @foreach (var carta in Model ?? Enumerable.Empty<MTGRoyal.Models.Carta>())
                {
                    var imageUrl = carta.ImagenUrl ?? string.Empty;
                    var priceText = carta.Precio.ToString("C", CultureInfo.GetCultureInfo("en-US"));
                    var priceValue = carta.Precio.ToString(CultureInfo.InvariantCulture);

                    <div class="budget-card" data-card-name="@carta.Nombre">

                        <img
                            src="@imageUrl"
                            class="budget-card-image"
                        />

                        <div class="budget-card-content">

                            <h3 class="budget-card-title">
                                @carta.Nombre
                            </h3>

                            <div class="budget-card-bottom">

                                <span class="budget-card-price">
                                    @priceText
                                </span>

                                <span class="budget-rarity">
                                    @carta.Rareza.Nombre
                                </span>

                            </div>

                            <button
                                class="add-btn"
                                data-card-name="@carta.Nombre"
                                data-card-price="@priceValue"
                                onclick="addBudgetCardToCart(this)">

                                + Agregar

                            </button>

                        </div>

                    </div>
                }

            </div>

        </div>

        <div class="cart-section">

            <div class="budget-chart-section">

                <div class="budget-chart-wrapper">

                    <canvas id="budgetChart"></canvas>

                </div>

                <div class="budget-values">

                    <span id="spentText">
                        Gastado: $0.00
                    </span>

                    <span id="remainingText">
                        Restante: $0.00
                    </span>

                </div>

            </div>

            <h2 class="section-title">
                🛒 Mi Carrito
            </h2>

            <div id="cartItems">

                <p class="empty-cart">
                    Tu carrito está vacío
                </p>

            </div>

            <div class="cart-total">

                <span>Total:</span>

                <span id="cartTotal">
                    $0.00
                </span>

            </div>

        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    let budgetChart;

    function getBudgetChartColor(percent){

        if(percent > 100)
            return "#f44336";

        if(percent > 75)
            return "#ff9800";

        return "#4caf50";

    }

    function initializeBudgetChart(){

        const chartCanvas =
            document.getElementById("budgetChart");

        if(!chartCanvas || typeof Chart === "undefined")
            return;

        budgetChart =
            new Chart(chartCanvas, {
                type: "doughnut",
                data: {
                    labels: ["Gastado", "Restante"],
                    datasets: [{
                        data: [0, 1],
                        backgroundColor: ["#4caf50", "#2a2f4a"],
                        borderColor: ["#1a1f3a", "#1a1f3a"],
                        borderWidth: 4,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: "68%",
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            callbacks: {
                                label: context =>
                                    `${context.label}: $${context.parsed.toFixed(2)}`
                            }
                        }
                    }
                }
            });

    }

    window.updateBudgetChart = function(summary){

        if(!budgetChart)
            return;

        const spent =
            summary.totalSpent;

        const remaining =
            Math.max(summary.remaining, 0);

        const hasBudget =
            summary.budget > 0;

        budgetChart.data.datasets[0].data =
            hasBudget
                ? [spent, remaining]
                : [0, 1];

        budgetChart.data.datasets[0].backgroundColor = [
            getBudgetChartColor(summary.percent),
            "#2a2f4a"
        ];

        budgetChart.update();

    };

    function addBudgetCardToCart(button){

        addToCart(
            button.dataset.cardName,
            parseFloat(button.dataset.cardPrice)
        );

    }

    function filterBudgetCards(text){

        const searchValue =
            text.toLowerCase().trim();

        const cards =
            document.querySelectorAll(".budget-card");

        cards.forEach(card => {

            const cardName =
                (card.dataset.cardName || "").toLowerCase();

            card.style.display =
                cardName.includes(searchValue)
                    ? "block"
                    : "none";

        });

    }

    initializeBudgetChart();
</script>
