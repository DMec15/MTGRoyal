<link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>

<div class="stores-container">

    <div class="stores-header">

        <h1 class="stores-title">
            Tiendas Cercanas
        </h1>

        <p class="stores-subtitle">
            Encuentra tiendas de Magic cerca de ti
        </p>

        <div class="store-search-row">

            <div class="search-wrapper">

                <span class="search-icon">
                    📍
                </span>

                <input
                    type="text"
                    id="citySearchInput"
                    class="catalog-search"
                    placeholder="Ingresa una ciudad..."
                    autocomplete="on"
                />

                <div
                    id="citySearchResults"
                    class="city-search-results">
                </div>

            </div>
            
        </div>

    </div>

    <div class="stores-map-card">

        <div id="storesMap"></div>

    </div>

</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    let storesMap;
    let searchTimer;
    let fakeStoreMarkers = [];

    const fakeStoreNames = [
        "Imperior",
        "Players Checkpoint",
        "Dragonshield",
        "Kame House",
        "Star City Games",
        "Mixfield"
    ];

    // Inicializa el mapa centrado en Mexico.
    function initializeStoresMap(){

        storesMap =
            L.map("storesMap").setView([23.6345, -102.5528], 5);

        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            maxZoom: 19,
            attribution: "&copy; OpenStreetMap contributors"
        }).addTo(storesMap);

    }

    // Consulta ciudades que coincidan con el texto buscado.
    async function fetchCities(query){

        const response =
            await fetch(
                `https://nominatim.openstreetmap.org/search?format=json&addressdetails=1&limit=5&q=${encodeURIComponent(query)}`
            );

        return await response.json();

    }

    // Muestra las ciudades encontradas debajo del buscador.
    async function showCityResults(text){

        const query =
            text.trim();

        const resultsContainer =
            document.getElementById("citySearchResults");

        if(!resultsContainer)
            return;

        resultsContainer.innerHTML = "";

        if(!query)
            return;

        const results =
            await fetchCities(query);

        if(!results || results.length === 0)
            return;

        results.forEach(city => {

            const result =
                document.createElement("button");

            result.type = "button";
            result.className = "city-search-result";
            result.innerText = city.display_name;
            // Selecciona la ciudad al hacer clic en un resultado.
            result.addEventListener("click", () => {

                selectCity(city);

            });

            resultsContainer.appendChild(result);

        });

    }

    // Centra el mapa en la ciudad seleccionada.
    function selectCity(city){

        const lat =
            parseFloat(city.lat);

        const lon =
            parseFloat(city.lon);

        storesMap.setView([lat, lon], 13);
        generateFakeStores(lat, lon);

        const input =
            document.getElementById("citySearchInput");

        const resultsContainer =
            document.getElementById("citySearchResults");

        if(input)
            input.value = city.display_name;

        if(resultsContainer)
            resultsContainer.innerHTML = "";

    }

    // Genera tres tiendas simuladas cerca de la ciudad.
    function generateFakeStores(lat, lon){

        clearFakeStores();

        const shuffledNames =
            [...fakeStoreNames].sort(() => Math.random() - 0.5);

        for(let index = 0; index < 3; index++){

            const point =
                getRandomNearbyPoint(lat, lon, 3);

            const marker =
                L.marker([point.lat, point.lon]).addTo(storesMap);

            marker.bindPopup(`
                <strong>${shuffledNames[index]}</strong><br/>
                Tienda de TCG y coleccionables
            `);

            fakeStoreMarkers.push(marker);

        }

    }

    // Elimina las tiendas simuladas anteriores del mapa.
    function clearFakeStores(){

        fakeStoreMarkers.forEach(marker => {

            storesMap.removeLayer(marker);

        });

        fakeStoreMarkers = [];

    }

    // Calcula una ubicacion aleatoria cercana al centro.
    function getRandomNearbyPoint(lat, lon, radiusKm){

        const angle =
            Math.random() * Math.PI * 2;

        const distanceKm =
            0.5 + Math.random() * radiusKm;

        const latitudeOffset =
            Math.cos(angle) * distanceKm / 111;

        const longitudeOffset =
            Math.sin(angle) * distanceKm / (111 * Math.cos(lat * Math.PI / 180));

        return {
            lat: lat + latitudeOffset,
            lon: lon + longitudeOffset
        };

    }

    // Prepara el mapa y los eventos del buscador al cargar la vista.
    document.addEventListener("DOMContentLoaded", () => {

        initializeStoresMap();

        const input =
            document.getElementById("citySearchInput");

        // Espera un momento antes de buscar mientras el usuario escribe.
        input?.addEventListener("input", event => {

            clearTimeout(searchTimer);

            searchTimer =
                // Actualiza la lista de resultados del buscador.
                setTimeout(() => {

                    showCityResults(event.target.value);

                }, 350);

        });

        // Permite seleccionar el primer resultado usando Enter.
        input?.addEventListener("keydown", async event => {

            if(event.key === "Enter"){

                event.preventDefault();

                const results =
                    await fetchCities(input.value);

                if(results && results.length > 0){

                    selectCity(results[0]);

                }

            }

        });

    });
</script>
