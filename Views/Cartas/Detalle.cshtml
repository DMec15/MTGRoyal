@model MTGRoyal.Models.Carta
@using System.Globalization

<div class="detail-container">

    <div class="detail-card">

        <img
            id="detailImage"
            class="detail-image"
            src="@Model.ImagenUrl"
        />

        <div class="detail-info">

            <h1 id="detailName">
                @Model.Nombre
            </h1>

            <div class="detail-price"
                 id="detailPrice">
                @Model.Precio.ToString("C", CultureInfo.GetCultureInfo("en-US"))
            </div>

            <div class="detail-group">

                <span class="detail-label">
                    Rareza
                </span>

                <span id="detailRarity">
                    @Model.Rareza.Nombre
                </span>

            </div>

            <div class="detail-group">

                <span class="detail-label">
                    Tipo
                </span>

                <span id="detailType">
                    @Model.Tipo
                </span>

            </div>

            <div class="detail-group">

                <span class="detail-label">
                    Coleccion
                </span>

                <span id="detailSet">
                    @(Model.Coleccion ?? "-")
                </span>

            </div>

        </div>

    </div>

</div>
