<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MTGRoyal</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MTGRoyal.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" />
</head>
<body>
    <header>

    </header>
    @{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    }
    <nav class="navbar-custom">

        <div class="navbar-container">

            <a class="nav-item @(currentController == "Home" ? "active" : "")" href="/">
                Inicio
            </a>

            <a class="nav-item @(currentController == "Catalogo" ? "active" : "")" href="/Catalogo/Index">
                Catálogo
            </a>

            <a class="nav-item @(currentController == "Tiendas" ? "active" : "")" href="/Tiendas/Index">
                Tiendas Cercanas
            </a>

            <a class="nav-item @(currentController == "Asesor" ? "active" : "")" href="/Asesor/Index">
                Asesor IA
            </a>

            <a class="nav-item @(currentController == "Presupuesto" ? "active" : "")" href="/Presupuesto/Index">
                Presupuesto
            </a>

            <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Personal" ? "active" : "")"
                asp-controller="Personal"
                asp-action="Index">

                Personal

            </a>

        </div>

    </nav>
    @RenderBody()

    <footer class="footer-custom">
        <div class="container-footer">
            &copy; 2026 - MTGRoyal - ITST
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script src="~/js/home.js"></script>
</body>
</html>
