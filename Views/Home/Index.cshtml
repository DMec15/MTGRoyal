@model IEnumerable<MTGRoyal.Models.Carta>
@using System.Text.Json

<div class="home-container">

    <div class="overlay"></div>

    <div class="contenido-home">

        <h1 class="titulo-principal">
            MTG ROYAL
        </h1>

        <div class="search-section">

            <input
                type="text"
                id="homeSearch"
                class="buscador"
                placeholder="Buscar cartas..."
                oninput="searchCardsFromDatabase(this.value)"
            />

            <div id="searchResults" class="search-results">

            </div>

        </div>

        <h3 class="subtitulo">
            Explora, compara y construye tu mazo perfecto
        </h3>

    </div>

</div>

<script>
    const databaseCards = @Html.Raw(JsonSerializer.Serialize(
        (Model ?? Enumerable.Empty<MTGRoyal.Models.Carta>()).Select(carta => new
        {
            id = carta.Id,
            name = carta.Nombre
        })
    ));

    // Busca cartas de la base de datos por nombre.
    function searchCardsFromDatabase(text){

        const results =
            document.getElementById("searchResults");

        if(!results)
            return;

        results.innerHTML = "";

        if(text.trim() === "")
            return;

        const filtered =
            databaseCards.filter(card =>
                card.name
                    .toLowerCase()
                    .includes(text.toLowerCase())
            );

        filtered.forEach(card => {

            results.innerHTML += `

                <div
                    class="search-item"
                    onclick="goToDatabaseCard('${card.id}')">

                    ${card.name}

                </div>

            `;

        });

        const exact =
            databaseCards.find(card =>
                card.name.toLowerCase() ===
                text.toLowerCase()
            );

        if(exact){

            goToDatabaseCard(exact.id);

        }

    }

    // Redirige al detalle de la carta seleccionada.
    function goToDatabaseCard(id){

        window.location.href =
            `/Cartas/Detalle/${id}`;

    }
</script>
